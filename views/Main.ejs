<!DOCTYPE html>
<html lang="<%= currentLang === 'en' ? 'en' : 'pt' %>">
<head>
    <meta charset="UTF-8">
    <title>Henriques.DEV</title>
    <link rel="stylesheet" href="/CSS/Main.css">
    <link rel="icon" href="/favicon.ico">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    <nav class="navbar">
        <div class="logo">Henriques.<span>DEV</span></div>
        <ul class="nav-links">
            <li><a href="/home" class="<%= currentPath === '/home' ? 'active' : '' %>"><%= currentLang === 'pt' ? 'Home' : 'Home' %></a></li>
            <li><a href="/servicos" class="<%= currentPath === '/servicos' ? 'active' : '' %>"><%= currentLang === 'pt' ? 'Serviços' : 'Services' %></a></li>
            <li><a href="/projetos" class="<%= currentPath === '/projetos' ? 'active' : '' %>"><%= currentLang === 'pt' ? 'Projetos' : 'Projects' %></a></li>
            <li><a href="/contactos" class="<%= currentPath === '/contactos' ? 'active' : '' %>"><%= currentLang === 'pt' ? 'Contactos' : 'Contacts' %></a></li>
            <div class="lang-switch">
              <% if(currentLang === 'pt') { %>
                <a href="/set-language/en" class="lang-btn">
                  <img src="/Imagens/en.png" alt="EN" width="49" height="22">
                </a>
              <% } else { %>
                <a href="/set-language/pt" class="lang-btn">
                  <img src="/Imagens/pt.png" alt="PT" width="49" height="22">
                </a>
              <% } %>
            </div>
        </ul>
    </nav>
    <main>
        <div class="arrow-right">
            <a href="/servicos" aria-label="Go to Services"><img src="/Imagens/arrow-right.png" alt="Arrow Right" width="120"></a>
        </div>
        <section class="hero">
            <div class="hero-left">
                <img id="profile-pic" src="/Imagens/portrait.png" alt="Francisco Henriques" class="profile-pic">
                <div class="socials">
                    <a href="https://www.linkedin.com/in/francisco-adelino-521513303/" target="_blank" aria-label="LinkedIn"><img src="/Imagens/linkedin.png" alt="LinkedIn" width="20"></a>
                    <a href="https://github.com/francisco3222" target="_blank" aria-label="GitHub"><img src="/Imagens/github.png" alt="GitHub" width="20"></a>
                    <a href="https://instagram.com/franciscoadelino756" target="_blank" aria-label="Instagram"><img src="/Imagens/instagram.png" alt="Instagram" width="20"></a>
                    <a href="https://discord.com/users/318829246850007041" target="_blank" aria-label="Discord"><img src="/Imagens/discord.png" alt="Discord" width="20"></a>
                </div>
            </div>
            <div class="hero-right">
                <h2>
                    <%= currentLang === 'pt' ? 'Olá' : 'Hello' %> <span aria-label="wave" role="img">👋</span>,
                    <%= currentLang === 'pt' ? 'sou o' : 'I am' %> <span class="highlight1">Francisco</span>
                </h2>
                <h3>
                    <%= currentLang === 'pt' ? 'E sou um' : 'And I am a' %> <span class="highlight2"><%= currentLang === 'pt' ? 'Desenvolvedor' : 'Developer' %></span>
                </h3>
                <p>
                    <%= currentLang === 'pt' ?
                        'Sou estudante de Engenharia Informática na Universidade da Madeira, apaixonado por desenvolvimento web, segurança de sistemas e criação de jogos.'
                        :
                        'I am a Computer Science student at the University of Madeira, passionate about web development, system security and game creation.' %>
                </p>
                <p>
                    <%= currentLang === 'pt' ?
                        'Procuro criar soluções eficientes, escaláveis e seguras, sempre com foco na experiência do utilizador. Tenho também grande interesse em desenvolvimento de jogos, em áreas como hitboxes, IA de NPCs e movimento de personagens.'
                        :
                        'I strive to create efficient, scalable, and secure solutions, always focusing on user experience. I am also greatly interested in game development, especially in areas such as hitboxes, NPC AI, and character movement.' %>
                </p>
                <div class="skills">
                    <img src="/Imagens/c.png" alt="C" title="C" width="30">
                    <img src="/Imagens/c++.png" alt="C++" title="C++" width="30">
                    <img src="/Imagens/csharp.png" alt="C#" title="C#" width="30">
                    <img src="/Imagens/javascript.png" alt="JavaScript" title="JavaScript" width="30">
                    <img src="/Imagens/php.png" alt="PHP" title="PHP" width="30">
                    <img src="/Imagens/python.png" alt="Python" title="Python" width="30">
                    <img src="/Imagens/mysql.png" alt="MySQL" title="MySQL" width="30">
                    <img src="/Imagens/react.png" alt="React" title="React" width="30">
                    <img src="/Imagens/nodejs.png" alt="Node.js" title="Node.js" width="30">
                    <img src="/Imagens/dotnet.png" alt=".NET" title=".NET" width="30">
                    <img src="/Imagens/blazor.png" alt="Blazor" title="Blazor" width="30">
                    <img src="/Imagens/expressjs.png" alt="ExpressJS" title="ExpressJS" width="30">
                </div>
                <a href="/contactos" class="hire-btn"><%= currentLang === 'pt' ? 'Hire Me' : 'Hire Me' %></a>
            </div>
            <div class="chatbot-button" id="chatbotButton">
                <img src="/Imagens/chatbot.png" alt="Chatbot" width="38" height="38">
            </div>
            <div class="chatbot-box" id="chatbotBox">
                <div class="chatbot-header">
                    <%= currentLang === 'pt' ? 'ChatBot' : 'ChatBot' %>
                    <span class="chatbot-close" id="chatbotClose">&times;</span>
                </div>
                <div class="chatbot-body">
                    <p><%= currentLang === 'pt' ? 'Olá! Como posso ajudar?' : 'Hello! How can I help?' %></p>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
