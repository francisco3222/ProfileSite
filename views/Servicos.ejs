<!-- File: `views/Servicos.ejs` -->
<!DOCTYPE html>
<html lang="<%= currentLang === 'en' ? 'en' : 'pt' %>">
<head>
    <meta charset="UTF-8">
    <title><%= currentLang === 'pt' ? 'Serviços - Henriques.DEV' : 'Services - Henriques.DEV' %></title>
    <link rel="stylesheet" href="/CSS/Main.css">
    <link rel="stylesheet" href="/CSS/Services.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
<main>
    <%- include('navBar') %>
    <div class="arrow-right">
        <a href="/projetos" aria-label="Go to Services"><img src="/Imagens/arrow-right.png" alt="Arrow Right" width="120"></a>
    </div>

    <header class="services-hero">
        <div class="hero-badge" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M12 2v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 18v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M4 12h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M16 12h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span><%= currentLang === 'pt' ? 'Serviços' : 'Services' %></span>
        </div>

        <h1 class="services-title">
            <%= currentLang === 'pt' ? 'Soluções Tecnológicas ' : 'Technology Solutions ' %>
            <span class="accent"><%= currentLang === 'pt' ? 'Inovadoras' : 'Innovative' %></span>
        </h1>

        <p class="services-sub">
            <%= currentLang === 'pt' ?
                    'Transformo as suas ideias em produtos digitais excecionais através de design criativo e tecnologia de ponta'
                    :
                    'Practical, secure solutions that boost your product — from interfaces to AI integrations.' %>
        </p>
    </header>
    <section class="services" style="padding:4rem 6%; min-height:80vh; background:#000;">

        <div class="services-grid">
            <article class="service-card" tabindex="0" aria-labelledby="svc-design-title" style="--accent:#ffffff;">
                <div class="card-media" aria-hidden="true">
                    <img src="/Imagens/desenvolvimentoweb.png" alt="">
                </div>
                <div class="card-body">
                    <h3 id="svc-design-title"><%= currentLang === 'pt' ? 'Design System Moderno' : 'Modern Design System' %></h3>
                    <p>
                        <%= currentLang === 'pt' ? 'Sistema de design completo com componentes reutilizáveis.' : 'Complete design system with reusable components and docs.' %>
                    </p>
                    <div class="tags" aria-hidden="true">
                        <span class="tag">Figma</span>
                        <span class="tag">Design System</span>
                        <span class="tag">UI/UX</span>
                    </div>
                </div>
                <button class="svc-cta" aria-label="<%= currentLang === 'pt' ? 'Ver detalhes' : 'View details' %>">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path>
                    </svg>
                </button>
            </article>

            <article class="service-card" tabindex="0" aria-labelledby="svc-ecom-title" style="--accent:#ffffff;">
                <div class="card-media" aria-hidden="true">
                    <img src="/Imagens/jogosdesenvolvimento.png" alt="">
                </div>
                <div class="card-body">
                    <h3 id="svc-ecom-title"><%= currentLang === 'pt' ? 'Plataforma E‑commerce' : 'E‑commerce Platform' %></h3>
                    <p>
                        <%= currentLang === 'pt' ? 'Loja online completa com carrinho, pagamentos e gestão de produtos.' : 'Full online store with cart, payments, and product management.' %>
                    </p>
                    <div class="tags" aria-hidden="true">
                        <span class="tag">React</span>
                        <span class="tag">TypeScript</span>
                        <span class="tag">Stripe</span>
                    </div>
                </div>
                <button class="svc-cta" aria-label="<%= currentLang === 'pt' ? 'Ver detalhes' : 'View details' %>">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path>
                    </svg>
                </button>
            </article>

            <article class="service-card" tabindex="0" aria-labelledby="svc-fit-title" style="--accent:rgb(255,214,214);">
                <div class="card-media" aria-hidden="true">
                    <img src="/Imagens/desenvolvimentoIA.png" alt="">
                </div>
                <div class="card-body">
                    <h3 id="svc-fit-title"><%= currentLang === 'pt' ? 'App Mobile Fitness' : 'Mobile Fitness App' %></h3>
                    <p>
                        <%= currentLang === 'pt' ? 'Aplicação mobile para tracking de exercícios, nutrição e automação.' : 'Mobile app for tracking exercises, nutrition and automation.' %>
                    </p>
                    <div class="tags" aria-hidden="true">
                        <span class="tag">Mobile</span>
                        <span class="tag">React Native</span>
                        <span class="tag">AI</span>
                    </div>
                </div>
                <button class="svc-cta" aria-label="<%= currentLang === 'pt' ? 'Ver detalhes' : 'View details' %>">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path>
                    </svg>
                </button>
            </article>

            <article class="service-card" tabindex="0" aria-labelledby="svc-api-title" style="--accent:#ffffff;">
                <div class="card-media" aria-hidden="true">
                    <img src="/Imagens/api-dev.png" alt="">
                </div>
                <div class="card-body">
                    <h3 id="svc-api-title"><%= currentLang === 'pt' ? 'APIs Escaláveis' : 'Scalable APIs' %></h3>
                    <p>
                        <%= currentLang === 'pt' ? 'Desenvolvimento de infraestruturas backend robustas e seguras.' : 'Development of robust and secure backend infrastructures.' %>
                    </p>
                    <div class="tags" aria-hidden="true">
                        <span class="tag">Node.js</span>
                        <span class="tag">PostgreSQL</span>
                        <span class="tag">Rest API</span>
                    </div>
                </div>
                <button class="svc-cta" aria-label="<%= currentLang === 'pt' ? 'Ver detalhes' : 'View details' %>">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path>
                    </svg>
                </button>
            </article>

            <article class="service-card" tabindex="0" aria-labelledby="svc-automation-title" style="--accent:rgb(214,255,214);">
                <div class="card-media" aria-hidden="true">
                    <img src="/Imagens/automacao.png" alt="">
                </div>
                <div class="card-body">
                    <h3 id="svc-automation-title"><%= currentLang === 'pt' ? 'Inteligência Artificial' : 'Artificial Intelligence' %></h3>
                    <p>
                        <%= currentLang === 'pt' ? 'Integração de LLMs e modelos preditivos para otimizar processos.' : 'Integration of LLMs and predictive models to optimize processes.' %>
                    </p>
                    <div class="tags" aria-hidden="true">
                        <span class="tag">Python</span>
                        <span class="tag">OpenAI</span>
                        <span class="tag">Automation</span>
                    </div>
                </div>
                <button class="svc-cta" aria-label="<%= currentLang === 'pt' ? 'Ver detalhes' : 'View details' %>">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path>
                    </svg>
                </button>
            </article>

            <article class="service-card" tabindex="0" aria-labelledby="svc-secure-title" style="--accent:rgb(214,220,255);">
                <div class="card-media" aria-hidden="true">
                    <img src="/Imagens/seguranca.png" alt="">
                </div>
                <div class="card-body">
                    <h3 id="svc-secure-title"><%= currentLang === 'pt' ? 'Cibersegurança' : 'Cybersecurity' %></h3>
                    <p>
                        <%= currentLang === 'pt' ? 'Auditoria de segurança e proteção de dados contra vulnerabilidades.' : 'Security auditing and data protection against vulnerabilities.' %>
                    </p>
                    <div class="tags" aria-hidden="true">
                        <span class="tag">Security</span>
                        <span class="tag">Auth</span>
                        <span class="tag">PenTesting</span>
                    </div>
                </div>
                <button class="svc-cta" aria-label="<%= currentLang === 'pt' ? 'Ver detalhes' : 'View details' %>">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path>
                    </svg>
                </button>
            </article>

            <article class="service-card" tabindex="0" aria-labelledby="svc-cloud-title" style="--accent:#ffffff;">
                <div class="card-media" aria-hidden="true">
                    <img src="/Imagens/api.png" alt="3D Cloud Server" style="left: -47%;width: 700px;object-fit: cover;margin-left: 0;">
                </div>
                <div class="card-body">
                    <h3 id="svc-cloud-title"><%= currentLang === 'pt' ? 'Infraestrutura Cloud' : 'Cloud Infrastructure' %></h3>
                    <p>
                        <%= currentLang === 'pt' ? 'Configuração e gestão de servidores e bases de dados na cloud.' : 'Setup and management of cloud servers and databases.' %>
                    </p>
                    <div class="tags" aria-hidden="true">
                        <span class="tag">AWS</span>
                        <span class="tag">Docker</span>
                        <span class="tag">CI/CD</span>
                    </div>
                </div>
                <button class="svc-cta" aria-label="<%= currentLang === 'pt' ? 'Ver detalhes' : 'View details' %>">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path>
                    </svg>
                </button>
            </article>

            <article class="service-card" tabindex="0" aria-labelledby="svc-seo-title" style="--accent:#ffffff;">
                <div class="card-media" aria-hidden="true">
                    <img src="/Imagens/seo.png" alt="">
                </div>
                <div class="card-body">
                    <h3 id="svc-seo-title"><%= currentLang === 'pt' ? 'Performance & SEO' : 'Performance & SEO' %></h3>
                    <p>
                        <%= currentLang === 'pt' ? 'Otimização de velocidade e visibilidade nos motores de busca.' : 'Speed optimization and search engine visibility.' %>
                    </p>
                    <div class="tags" aria-hidden="true">
                        <span class="tag">SEO</span>
                        <span class="tag">Vitals</span>
                        <span class="tag">Analytics</span>
                    </div>
                </div>
                <button class="svc-cta" aria-label="<%= currentLang === 'pt' ? 'Ver detalhes' : 'View details' %>">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path>
                    </svg>
                </button>
            </article>
        </div>

        <div style="max-width:500px; margin:2.5rem auto 0; padding:2rem; border-radius:18px;
            background: linear-gradient(135deg, rgba(101,5,5,0.55), rgba(14,14,20,0.35));
            border: 1px solid rgba(242,77,77,0.12);
            box-shadow: 0 12px 36px rgba(0,0,0,0.6);
            backdrop-filter: blur(6px);
            text-align:center; display: flex; flex-direction: column; align-items: center;">

            <h2 style="color:#fff; font-size:1.35rem; margin-bottom:0.5rem; font-weight:600;">
                Tem um projeto em mente?
            </h2>
            <p style="color:rgba(255,255,255,0.78); margin-bottom:1.25rem; font-size:1rem;">
                Vamos trabalhar juntos para criar algo extraordinário
            </p>

            <a href="/contactos" style="display:inline-block; padding:10px 28px; border-radius:999px;
                               background: linear-gradient(90deg, rgba(210,0,0,0.88) 0%, #f04c4c 60%);
                               color:#fff; text-decoration:none; font-weight:700;
                               box-shadow: 0 10px 30px rgba(255,0,0,0.18);
                               transition: transform 180ms ease, box-shadow 180ms ease;">
                Contacte‑me
            </a>

        </div>
        <%- include('ChatBot')%>
    </section>
</main>
<%- include('Footer')%>
</body>
</html>
